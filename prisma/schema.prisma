// ============================================================
//  FLIX — Prisma Schema
//  Converted from SQL schema (Production-Ready)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
//  ENUMS
// ============================================================

enum Role {
  user
  moderator
  admin
}

enum DiscussionCategory {
  general
  theory
  review
  question
}

enum LikeTargetType {
  discussion
  reply
  cinepost
  cinecomment
}

enum CinePostType {
  text
  film_review
  film_recommendation
  poll
  question
}

enum CineMediaType {
  image
  gif
  video
}

enum NotificationType {
  like_discussion
  like_reply
  reply_thread
  nested_reply
  watchlist_invite
  new_follower
  // Lama (dipertahankan agar tidak break DB yang sudah ada)
  like_cinecomment
  mention_cinepost
  // CineThread baru
  like_cinepost
  comment_cinepost
  repost_cinepost
  quote_cinepost
  reply_cinecomment
}

enum ReportTargetType {
  discussion
  reply
  user
  cinepost
  cinecomment
}

enum ReportStatus {
  pending
  resolved
  rejected
}

enum WatchlistMemberRole {
  viewer
  editor
}

enum MessageStatus {
  sent
  delivered
  read

  @@map("MessageStatus")
}

enum MessageContentType {
  text
  image
  film_tag
  cinethread_share

  @@map("MessageContentType")
}

// ============================================================
//  1. USERS
// ============================================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  role         Role      @default(user)
  isBanned     Boolean   @default(false) @map("is_banned")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  ratings           Rating[]
  reviews           Review[]
  watchlists        Watchlist[]        @relation("WatchlistOwner")
  watchlistMembers  WatchlistMember[]
  discussions       Discussion[]
  replies           DiscussionReply[]
  likes             Like[]
  notifications     Notification[]
  reports           Report[]           @relation("Reporter")
  resolvedReports   Report[]           @relation("Resolver")
  activityLogs      ActivityLog[]
  followers         Follow[]           @relation("Following")
  following         Follow[]           @relation("Follower")
  // CineThread
  cinePosts         CinePost[]
  cineComments      CineComment[]
  cineReposts       CineRepost[]
  cineSaves         CineSave[]
  // Messaging
  conversationsAsOne  Conversation[]       @relation("ConvUserOne")
  conversationsAsTwo  Conversation[]       @relation("ConvUserTwo")
  sentMessages        Message[]            @relation("SentMessages")
  readReceipts        MessageReadReceipt[]
  sentRequests        MessageRequest[]     @relation("SentRequests")
  receivedRequests    MessageRequest[]     @relation("ReceivedRequests")

  @@map("users")
}

// ============================================================
//  2. GENRES
// ============================================================

model Genre {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)

  films FilmGenre[]

  @@map("genres")
}

// ============================================================
//  3. MOODS
// ============================================================

model Mood {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(50)
  emoji    String? @db.VarChar(10)
  colorHex String? @map("color_hex") @db.VarChar(7)

  films FilmMood[]

  @@map("moods")
}

// ============================================================
//  4. FILMS
// ============================================================

model Film {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  omdbId          String?  @unique @map("omdb_id") @db.VarChar(20)
  title           String   @db.VarChar(255)
  releaseYear     Int?     @map("release_year") @db.SmallInt
  posterUrl       String?  @map("poster_url") @db.VarChar(500)
  synopsis        String?  @db.Text
  imdbRating      Decimal? @map("imdb_rating") @db.Decimal(3, 1)
  durationMinutes Int?     @map("duration_minutes") @db.SmallInt
  director        String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  genres          FilmGenre[]
  moods           FilmMood[]
  ratings         Rating[]
  reviews         Review[]
  discussions     Discussion[]
  watchlistItems  WatchlistItem[]
  // CineThread
  cineFilmTags        CineFilmTag[]
  // Messaging
  messageAttachments  MessageAttachment[]

  @@map("films")
}

// ============================================================
//  5. FILM_GENRES & FILM_MOODS
// ============================================================

model FilmGenre {
  filmId  String @map("film_id") @db.Uuid
  genreId Int    @map("genre_id")

  film  Film  @relation(fields: [filmId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([filmId, genreId])
  @@map("film_genres")
}

model FilmMood {
  filmId String @map("film_id") @db.Uuid
  moodId Int    @map("mood_id")

  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@id([filmId, moodId])
  @@map("film_moods")
}

// ============================================================
//  6. RATINGS
// ============================================================

model Rating {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  filmId    String   @map("film_id") @db.Uuid
  score     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([filmId])
  @@index([userId])
  @@map("ratings")
}

// ============================================================
//  7. REVIEWS
// ============================================================

model Review {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  filmId    String    @map("film_id") @db.Uuid
  content   String    @db.Text
  isSpoiler Boolean   @default(false) @map("is_spoiler")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([filmId])
  @@map("reviews")
}

// ============================================================
//  8. WATCHLISTS
// ============================================================

model Watchlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String   @default("My Watchlist") @db.VarChar(100)
  isShared  Boolean  @default(false) @map("is_shared")
  shareCode String?  @unique @map("share_code") @db.VarChar(12)
  createdAt DateTime @default(now()) @map("created_at")

  owner   User              @relation("WatchlistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items   WatchlistItem[]
  members WatchlistMember[]

  @@index([ownerId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watchlistId String   @map("watchlist_id") @db.Uuid
  filmId      String   @map("film_id") @db.Uuid
  isWatched   Boolean  @default(false) @map("is_watched")
  addedAt     DateTime @default(now()) @map("added_at")

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  film      Film      @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, filmId])
  @@map("watchlist_items")
}

model WatchlistMember {
  watchlistId String              @map("watchlist_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  role        WatchlistMemberRole @default(viewer)
  joinedAt    DateTime            @default(now()) @map("joined_at")

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([watchlistId, userId])
  @@map("watchlist_members")
}

// ============================================================
//  9. DISCUSSIONS
// ============================================================

model Discussion {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filmId     String             @map("film_id") @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  title      String             @db.VarChar(200)
  body       String             @db.Text
  category   DiscussionCategory @default(general)
  viewsCount Int                @default(0) @map("views_count")
  deletedAt  DateTime?          @map("deleted_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  film    Film              @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies DiscussionReply[]
  tags    DiscussionTag[]

  @@index([filmId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("discussions")
}

// ============================================================
//  10. DISCUSSION_REPLIES
// ============================================================

model DiscussionReply {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discussionId  String    @map("discussion_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  parentReplyId String?   @map("parent_reply_id") @db.Uuid
  body          String    @db.Text
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  discussion  Discussion        @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentReply DiscussionReply?  @relation("ReplyChildren", fields: [parentReplyId], references: [id], onDelete: Cascade)
  children    DiscussionReply[] @relation("ReplyChildren")

  @@index([discussionId])
  @@index([parentReplyId])
  @@map("discussion_replies")
}

// ============================================================
//  11. DISCUSSION_TAGS
// ============================================================

model DiscussionTag {
  discussionId String @map("discussion_id") @db.Uuid
  tag          String @db.VarChar(50)

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@id([discussionId, tag])
  @@index([tag])
  @@map("discussion_tags")
}

// ============================================================
//  12. LIKES (Polymorphic via named relations)
// ============================================================

model Like {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  targetType LikeTargetType @map("target_type")
  targetId   String         @map("target_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  // Only relate to User; target is polymorphic (discussion or reply)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("likes")
}

// ============================================================
//  13. NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  message   String           @db.Text
  targetUrl String?          @map("target_url") @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ============================================================
//  14. REPORTS
// ============================================================

model Report {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId  String           @map("reporter_id") @db.Uuid
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id") @db.Uuid
  reason      String           @db.Text
  status      ReportStatus     @default(pending)
  resolvedBy  String?          @map("resolved_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  reporter User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver User? @relation("Resolver", fields: [resolvedBy], references: [id])

  @@index([status])
  @@map("reports")
}

// ============================================================
//  15. FOLLOWS
// ============================================================

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ============================================================
//  16. ACTIVITY_LOGS
// ============================================================

model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.Text
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

// ============================================================
//  17. CINETHREAD — POSTS
// ============================================================

model CinePost {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId      String       @map("author_id") @db.Uuid
  threadRootId  String?      @map("thread_root_id") @db.Uuid
  threadOrder   Int          @default(0) @map("thread_order") @db.SmallInt
  postType      CinePostType @default(text) @map("post_type")
  content       String?      @db.Text
  viewsCount    Int          @default(0) @map("views_count")
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  threadRoot  CinePost?     @relation("ThreadChain", fields: [threadRootId], references: [id], onDelete: Cascade)
  threadItems CinePost[]    @relation("ThreadChain")
  media       CineMedia[]
  filmTags    CineFilmTag[]
  hashtags    CineHashtag[]
  comments    CineComment[]
  saves       CineSave[]
  reposts     CineRepost[]  @relation("OriginalPost")
  quoteOf     CineRepost[]  @relation("QuotedPost")
  // Messaging
  messageAttachments MessageAttachment[]

  @@index([authorId])
  @@index([threadRootId])
  @@index([createdAt(sort: Desc)])
  @@map("cinethread_posts")
}

// ============================================================
//  18. CINETHREAD — MEDIA
// ============================================================

model CineMedia {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  mediaType CineMediaType @map("media_type")
  url       String        @db.VarChar(500)
  altText   String?       @map("alt_text") @db.VarChar(255)
  sortOrder Int           @default(0) @map("sort_order") @db.SmallInt

  post CinePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("cinethread_media")
}

// ============================================================
//  19. CINETHREAD — FILM TAGS
// ============================================================

model CineFilmTag {
  postId String @map("post_id") @db.Uuid
  filmId String @map("film_id") @db.Uuid

  post CinePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  film Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([postId, filmId])
  @@map("cinethread_film_tags")
}

// ============================================================
//  20. CINETHREAD — HASHTAGS
// ============================================================

model CineHashtag {
  postId  String @map("post_id") @db.Uuid
  hashtag String @db.VarChar(100)

  post CinePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, hashtag])
  @@index([hashtag])
  @@map("cinethread_hashtags")
}

// ============================================================
//  21. CINETHREAD — COMMENTS
// ============================================================

model CineComment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  parentCommentId String?  @map("parent_comment_id") @db.Uuid
  content        String    @db.Text
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  post          CinePost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment CineComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       CineComment[] @relation("CommentReplies")

  @@index([postId])
  @@index([parentCommentId])
  @@map("cinethread_comments")
}

// ============================================================
//  22. CINETHREAD — SAVES
// ============================================================

model CineSave {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  savedAt   DateTime @default(now()) @map("saved_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CinePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId])
  @@map("cinethread_saves")
}

// ============================================================
//  23. CINETHREAD — REPOSTS
// ============================================================

model CineRepost {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  originalPostId String   @map("original_post_id") @db.Uuid
  quotePostId    String?  @map("quote_post_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalPost CinePost @relation("OriginalPost", fields: [originalPostId], references: [id], onDelete: Cascade)
  quotePost    CinePost? @relation("QuotedPost", fields: [quotePostId], references: [id], onDelete: SetNull)

  @@unique([userId, originalPostId])
  @@index([originalPostId])
  @@map("cinethread_reposts")
}

// ============================================================
//  24. MESSAGING — CONVERSATIONS
// ============================================================

model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userOneId     String    @map("user_one_id") @db.Uuid
  userTwoId     String    @map("user_two_id") @db.Uuid
  lastMessageId String?   @map("last_message_id") @db.Uuid
  lastActivity  DateTime  @default(now()) @map("last_activity")
  createdAt     DateTime  @default(now()) @map("created_at")

  userOne     User      @relation("ConvUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo     User      @relation("ConvUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  lastMessage Message?  @relation("LastMessage", fields: [lastMessageId], references: [id])
  messages    Message[] @relation("ConvMessages")

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@index([lastActivity(sort: Desc)])
  @@map("conversations")
}

// ============================================================
//  25. MESSAGING — MESSAGES
// ============================================================

model Message {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  senderId       String             @map("sender_id") @db.Uuid
  contentType    MessageContentType @default(text) @map("content_type")
  body           String?            @db.Text
  status         MessageStatus      @default(sent)
  deletedAt      DateTime?          @map("deleted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  conversation Conversation        @relation("ConvMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]
  readReceipts MessageReadReceipt[]
  lastInConv   Conversation[]      @relation("LastMessage")

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt(sort: Asc)])
  @@map("messages")
}

// ============================================================
//  26. MESSAGING — ATTACHMENTS
// ============================================================

model MessageAttachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  mediaUrl   String?  @map("media_url") @db.VarChar(500)
  altText    String?  @map("alt_text") @db.VarChar(200)
  filmId     String?  @map("film_id") @db.Uuid
  cinepostId String?  @map("cinepost_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  message  Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  film     Film?           @relation(fields: [filmId], references: [id], onDelete: SetNull)
  cinepost CinePost?       @relation(fields: [cinepostId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@map("message_attachments")
}

// ============================================================
//  27. MESSAGING — READ RECEIPTS
// ============================================================

model MessageReadReceipt {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_read_receipts")
}

// ============================================================
//  28. MESSAGING — MESSAGE REQUESTS
// ============================================================

model MessageRequest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  receiverId String   @map("receiver_id") @db.Uuid
  message    String?  @db.Text
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  sender   User @relation("SentRequests",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
  @@map("message_requests")
}
